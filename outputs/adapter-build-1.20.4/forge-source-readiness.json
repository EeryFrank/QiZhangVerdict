  "sourceApiConclusions": {
    "event": "Forge49 CustomPayloadEvent.getSource directly returns Context; no sender-side subclass names.",
    "direction": "Explicit PLAY_TO_SERVER and PLAY_TO_CLIENT branches. ConnectionProtocol.PLAY check excludes configuration and login.",
    "thread": "Context.enqueueWork dispatches to reception-side WORKQUEUE. All game/player mutations occur in the callback.",
    "rawWire": "EventNetworkChannel.toBuffer returns the input FriendlyByteBuf; Channel uses NetworkDirection.buildPacket and DiscardedPayload(channel,buffer) without a SimpleChannel discriminator.",
    "remoteChannels": "ChannelListManager handles minecraft:register and stores remote channels for Channel.isRemotePresent. ChannelBuilder.optional accepts VANILLA/MISSING; core still enforces required reports.",
    "ownership": "Server official PacketDistributor calls player.connection.getConnection. Adapter compares originating connection on reception and final client send; shared guard verifies Player object ownership.",
    "resourceFormat": "Official 49.2.9 MDK pack.mcmeta specifies pack_format22."
  },
